<?xml version="1.0" encoding="utf-8"?>
<!--
    Code editor screen.

    ConstraintLayout root (fitsSystemWindows + adjustResize in manifest) so the
    layout resizes rather than clips when the IME or system gesture bars expand.
    The editor area is a horizontal LinearLayout: a monospace line-number gutter
    (lineNumbers) on the left and the scrollable monospace EditText (editor) on
    the right, sharing the same line height so the gutter stays aligned. A
    guideline splits the editor area from the compiler output pane, which is
    pinned to the bottom and shrinks (not clips) under the keyboard.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <LinearLayout
        android:id="@+id/project_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:id="@+id/project_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp" />
        <Spinner
            android:id="@+id/board_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/project_row"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <Button android:id="@+id/new_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="New" />
        <Button android:id="@+id/save_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Save" />
        <Button android:id="@+id/compile_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Verify" />
        <Button android:id="@+id/upload_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Upload" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/editor_output_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.62" />

    <LinearLayout
        android:id="@+id/editor_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:background="@color/editor_background"
        app:layout_constraintTop_toBottomOf="@id/button_row"
        app:layout_constraintBottom_toTopOf="@id/editor_output_divider"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/lineNumbers"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@color/surface_variant_dark"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="@color/line_number"
            android:gravity="top|end"
            android:paddingTop="12dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:scrollbars="none"
            android:text="1" />

        <HorizontalScrollView
            android:id="@+id/editorScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">
            <EditText
                android:id="@+id/editor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="300dp"
                android:gravity="top|start"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="@color/editor_text"
                android:inputType="textMultiLine|textNoSuggestions"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                android:padding="12dp"
                android:background="@null" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/output"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_dark"
        android:fontFamily="monospace"
        android:textColor="@color/editor_text"
        android:padding="8dp"
        android:textIsSelectable="true"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/editor_output_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
