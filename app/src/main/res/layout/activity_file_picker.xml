<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">
    
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface_dark"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Sketch"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>
    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/newSketchButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="New Sketch"
        android:textAllCaps="false"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />
    
    <ListView
        android:id="@+id/fileListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/surface_dark"
        android:divider="@color/on_surface_variant"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/newSketchButton"
        app:layout_constraintBottom_toBottomOf="parent" />
    
    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No sketches found"
        android:textColor="@color/on_surface_variant"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/newSketchButton"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
