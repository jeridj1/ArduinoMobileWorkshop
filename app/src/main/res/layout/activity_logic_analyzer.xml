<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_dark">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        tools:context=".ui.LogicAnalyzerActivity">

        <TextView
            android:id="@+id/logic_analyzer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logic_analyzer_title"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/logic_analyzer_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Ready"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logic_analyzer_title" />

        <TextView
            android:id="@+id/logic_analyzer_hookup_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@color/surface_variant_dark"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/on_surface"
            android:text="MODE: Logic Analyzer

Connect Pico GP2 -> CH0 (signal under test)
Connect Pico GP3 -> CH1
Connect Pico GP4 -> CH2
Connect Pico GP5 -> CH3
Connect Pico GND -> Target GND

Flash helper firmware to prepare the Pico as a logic analyzer."
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logic_analyzer_status" />

        <Button
            android:id="@+id/logic_analyzer_prepare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Prepare Pico (Flash LA Firmware)"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logic_analyzer_hookup_guide" />

        <TextView
            android:id="@+id/textView_sample_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sample Rate:"
            android:textSize="18sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logic_analyzer_prepare" />

        <Spinner
            android:id="@+id/logic_analyzer_sample_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toRightOf="@+id/textView_sample_rate"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView_sample_rate" />

        <TextView
            android:id="@+id/textView_channels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Channels:"
            android:textSize="18sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logic_analyzer_sample_rate" />

        <Spinner
            android:id="@+id/logic_analyzer_channels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toRightOf="@+id/textView_channels"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView_channels" />

        <Button
            android:id="@+id/logic_analyzer_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/logic_analyzer_start"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/logic_analyzer_stop"
            app:layout_constraintTop_toBottomOf="@+id/logic_analyzer_channels" />

        <Button
            android:id="@+id/logic_analyzer_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/logic_analyzer_stop"
            app:layout_constraintLeft_toRightOf="@+id/logic_analyzer_start"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/logic_analyzer_start" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logic_analyzer_capture_view"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/logic_analyzer_start" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
