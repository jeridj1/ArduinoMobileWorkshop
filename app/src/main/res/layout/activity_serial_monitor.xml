<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">
    
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface_dark"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Serial Monitor"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_variant_dark"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Baud Rate:"
            android:textColor="@color/on_surface"
            android:gravity="center_vertical" />
        <Spinner
            android:id="@+id/baudRateSpinner"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="Connect"
            android:textAllCaps="false" />
    </LinearLayout>
    
    <androidx.core.widget.NestedScrollView
        android:id="@+id/serialOutputScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/editor_background"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/inputBar">
        <TextView
            android:id="@+id/serialOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/editor_text"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:padding="16dp" />
    </androidx.core.widget.NestedScrollView>
    
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_variant_dark"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:hint="Enter text to send..."
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:imeOptions="actionSend" />
        <Spinner
            android:id="@+id/newlineSpinner"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="Send"
 
           android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="Clear"
            android:textAllCaps="false" />
    </LinearLayout>
    
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/autoScrollSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-scroll"
        android:textColor="@color/on_surface"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
